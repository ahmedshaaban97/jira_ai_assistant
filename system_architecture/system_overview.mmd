%% =======================
%% APPLICATION / CREW LAYER
%% =======================
subgraph APP_LAYER["Application & CrewAI Layer"]

  MainEntry["CLI Entrypoint
- File: src/jira_ai_assistant/main.py
- Loads .env (JIRA_URL, EMAIL, API_KEY, etc.)
- Calls JiraAiAssistant().crew().kickoff(...)
"]

  CrewDef["JiraAiAssistant Crew
- File: src/jira_ai_assistant/crew.py
- Framework: CrewAI (hierarchical process)
- Uses config:
  * config/agents.yaml
  * config/tasks.yaml
- Output models: outputs.py
"]

  ProductAgent["Product Manager Agent
- Config key: product_manager
- LLM: gpt-4o-mini
- Tools:
  * PdfFileRetriever
  * Jira* tools (read/write)
- Tasks:
  * plan_epic_backlog
  * execute_epic_backlog
"]

  GuardrailAgent["Planning Guardrail Manager Agent
- Config key: planning_guardrail
- Acts as CrewAI manager_agent
- Reviews backlog plan & execution
- Enforces planning guardrails & risk checks
"]

end

