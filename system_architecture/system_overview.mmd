%% =======================
%% CONNECTIONS
%% =======================

%% UI entrypoints
GradioUI -->|"Run Assistant tab
Kickoff crew with project_key, epic_key, extra JSON"| CrewDef
MainEntry -->|"Direct kickoff (local CLI run)"| CrewDef

%% Crew internal wiring
CrewDef -->|"Hierarchical process manager_agent"| GuardrailAgent
CrewDef -->|"Executes tasks with tools"| ProductAgent

%% Agent -> tools
ProductAgent -->|"CV loading & skills extraction"| CVTool
ProductAgent -->|"Jira read/write operations"| JiraTools

%% Tools -> external / data
CVTool -->|"Load PDF resumes"| ResumeDocs
JiraTools -->|"REST HTTP calls"| JiraCloud
JiraTools -->|"Use credentials from"| EnvFile

%% Config & outputs
CrewDef -->|"Reads agent & task definitions"| ConfigFiles
ProductAgent -->|"Write plan & execution artifacts"| OutputFiles

%% UI & outputs
GradioUI -->|"Outputs Overview tab
Reads markdown artifacts from /output"| OutputFiles

%% UI & Jira tools (utilities)
GradioUI -->|"Jira Utilities tab
Direct read-only calls to Jira tools"| JiraTools

